root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Makefile recipes require tab indentation.
[Makefile]
indent_style = tab

# Trailing whitespace may be significant in test inputs and manifests.
[*.{cmm,tsv}]
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false
