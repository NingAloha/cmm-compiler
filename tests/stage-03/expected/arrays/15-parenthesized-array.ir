FUNCTION head :
PARAM v1
t1 := #0 * #4
t2 := v1 + t1
t3 := *t2
RETURN t3
FUNCTION main :
DEC v2 16
t4 := #0 * #8
t5 := #0 * #4
t6 := t4 + t5
t7 := &v2 + t6
*t7 := #7
t8 := #0 * #8
t9 := #1 * #4
t10 := t8 + t9
t11 := &v2 + t10
*t11 := #9
t12 := #0 * #8
t13 := #1 * #4
t14 := t12 + t13
t15 := &v2 + t14
t16 := *t15
WRITE t16
t17 := #0 * #8
t18 := &v2 + t17
ARG t18
t19 := CALL head
WRITE t19
RETURN #0
