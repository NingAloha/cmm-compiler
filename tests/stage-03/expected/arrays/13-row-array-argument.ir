FUNCTION sum_row :
PARAM v1
t1 := #0 * #4
t2 := v1 + t1
t3 := *t2
t4 := #1 * #4
t5 := v1 + t4
t6 := *t5
t7 := t3 + t6
t8 := #2 * #4
t9 := v1 + t8
t10 := *t9
t11 := t7 + t10
RETURN t11
FUNCTION main :
DEC v2 24
t12 := #1 * #12
t13 := #0 * #4
t14 := t12 + t13
t15 := &v2 + t14
*t15 := #10
t16 := #1 * #12
t17 := #1 * #4
t18 := t16 + t17
t19 := &v2 + t18
*t19 := #20
t20 := #1 * #12
t21 := #2 * #4
t22 := t20 + t21
t23 := &v2 + t22
*t23 := #12
t24 := #1 * #12
t25 := &v2 + t24
ARG t25
t26 := CALL sum_row
RETURN t26
