FUNCTION add :
PARAM v1
t1 := #0 * #4
t2 := v1 + t1
t3 := *t2
t4 := #1 * #4
t5 := v1 + t4
t6 := *t5
t7 := t3 + t6
RETURN t7
FUNCTION main :
DEC v2 8
DEC v3 8
v4 := #0
v5 := #0
LABEL label1 :
IF v4 < #2 GOTO label2
GOTO label3
LABEL label2 :
LABEL label4 :
IF v5 < #2 GOTO label5
GOTO label6
LABEL label5 :
t8 := v4 + v5
t9 := v5 * #4
t10 := &v2 + t9
*t10 := t8
t11 := v5 + #1
v5 := t11
GOTO label4
LABEL label6 :
ARG &v2
t12 := CALL add
t13 := #0 * #8
t14 := v4 * #4
t15 := t13 + t14
t16 := &v3 + t15
*t16 := t12
t17 := #0 * #8
t18 := v4 * #4
t19 := t17 + t18
t20 := &v3 + t19
t21 := *t20
WRITE t21
t22 := v4 + #1
v4 := t22
v5 := #0
GOTO label1
LABEL label3 :
RETURN #0
